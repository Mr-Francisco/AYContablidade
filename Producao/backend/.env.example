# AYContabilidade — Backend
#
# ESTE FICHEIRO É UM MODELO VERSIONADO — vai para o repositório e é público.
# NUNCA escrever valores reais aqui. Só nomes de variáveis e exemplos inócuos.
#
# Os valores reais vão para o `.env` ao lado, que o .gitignore ignora:
#     cp .env.example .env
# e preencher lá.

# ---------- Aplicação ----------
APP_NAME=AYContabilidade
AMBIENTE=dev
API_PORT=8001

# ---------- Base de dados (PostgreSQL 18) ----------
# O serviço local corre em localhost:5432. Substituir UTILIZADOR/PALAVRA_PASSE/BASE.
DATABASE_URL=postgresql+psycopg://UTILIZADOR:PALAVRA_PASSE@localhost:5432/aycontabilidade

# ---------- Autenticação ----------
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo 32 caracteres — a aplicação recusa arrancar com uma chave mais curta.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTOS=30
SESSAO_ABSOLUTA_HORAS=12
PASSWORD_MIN_CARACTERES=8

# ---------- Rate limiting ----------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_GERAL=120/minute

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000

# ---------- Integração AGT (consulta de NIF) ----------
AGT_ATIVO=false
AGT_ENDPOINT=https://sifphml.minfin.gov.ao/sigt/contribuinte/consultarNIF/v5/obter
AGT_USERNAME=
AGT_PASSWORD=

# ---------- OpenAI (exclusivamente o módulo de perguntas e respostas) ----------
# Sem chave, o módulo de perguntas fica indisponível — mas o diagnóstico de
# erros continua a funcionar, porque é inteiramente local.
OPENAI_API_KEY=
# Consultar GET /api/ia/modelos para ver os modelos que a chave consegue usar
# e escolher o mais recente.
OPENAI_MODELO=gpt-4o
OPENAI_TIMEOUT_SEGUNDOS=90
