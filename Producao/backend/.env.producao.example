# AYContabilidade — Backend, PRODUÇÃO
#
# ESTE FICHEIRO É UM MODELO VERSIONADO — vai para o repositório e é público.
# NUNCA escrever valores reais aqui.
#
#     cp .env.producao.example .env
#
# e preencher o `.env`, que o .gitignore ignora.
#
# A aplicação RECUSA-SE A ARRANCAR com AMBIENTE=producao se alguma destas
# definições estiver como em desenvolvimento. A mensagem de erro diz qual.

# ---------- Aplicação ----------
APP_NAME=AYContabilidade
# `producao` liga as guardas, fecha a documentação da API (/docs) e desliga o
# eco do SQL nos registos.
AMBIENTE=producao
API_PORT=8001

# ---------- Base de dados ----------
# A base de produção, NÃO a de desenvolvimento. O arranque avisa se apontar
# para localhost.
DATABASE_URL=postgresql+psycopg://UTILIZADOR:PALAVRA_PASSE@BASE_DE_DADOS:5432/aycontabilidade

# ---------- Segredos ----------
# Gerar cada um com o seu próprio comando, e nunca reutilizar entre ambientes:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Cifra os segredos de 2FA em repouso. OBRIGATÓRIA em produção: sem ela ninguém
# activa o segundo factor, e as contas de administração da plataforma exigem-no
# — a plataforma ficaria sem operador.
#
# GUARDE-A FORA DA MÁQUINA. Perdê-la obriga toda a gente a reconfigurar o 2FA.
TOTP_CHAVE_CIFRA=

# ---------- Sessões ----------
ACCESS_TOKEN_MINUTOS=30
SESSAO_ABSOLUTA_HORAS=12
# A conta que administra a plataforma vale todas as empresas juntas.
SESSAO_SUPERADMIN_HORAS=2
ACCESS_TOKEN_SUPERADMIN_MINUTOS=15

# ---------- Segundo factor ----------
TOTP_MAX_TENTATIVAS=3
TOTP_BLOQUEIO_MINUTOS=15
TOTP_DESAFIO_MINUTOS=5

# ---------- Palavras-passe ----------
# 8 é o mínimo aceite em produção; subir é seguro, descer faz o arranque falhar.
PASSWORD_MIN_CARACTERES=10

# ---------- Limites de pedidos ----------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_GERAL=120/minute

# ---------- CORS ----------
# O endereço PÚBLICO do frontend, em https. Sem localhost e sem http — o
# arranque recusa os dois, porque o token de sessão viajaria em claro.
CORS_ORIGINS=https://app.oseudominio.ao

# ---------- Proxy ----------
# Se houver um proxy ou balanceador à frente (nginx, Caddy, Cloudflare), ponha
# aqui os endereços em cujo X-Forwarded-For se pode confiar. VAZIO é o valor
# seguro: sem isto, qualquer cliente escolhe o IP que fica na auditoria.
#   PROXIES_CONFIAVEIS=10.0.0.0/8,172.18.0.1
PROXIES_CONFIAVEIS=

# ---------- Integração AGT (consulta de NIF) ----------
# CONSULTA DE NIF NA AGT.
#
# Sem estas tres linhas preenchidas, a consulta NAO FUNCIONA: o servico responde
# 401 e o sistema devolve so a validacao do formato do numero, com o nome por
# preencher a mao. Nao e um defeito — e falta de credenciais.
#
# O ENDERECO AQUI E O DE PRODUCAO (`sifp`), e nao o de testes (`sifphml`). Sao
# dois servicos diferentes e as credenciais de um nao servem no outro.
AGT_ATIVO=true
AGT_ENDPOINT=https://sifp.minfin.gov.ao/sigt/contribuinte/consultarNIF/v5/obter
AGT_USERNAME=
AGT_PASSWORD=

# ---------- OpenAI ----------
# Exclusivamente o módulo autorizado de perguntas e respostas. Sem chave, o
# assistente fica indisponível e o diagnóstico continua a funcionar — corre
# inteiramente no servidor.
#
# O MODELO e os PREÇOS não se configuram aqui: vivem no registo de modelos, em
# Plataforma → Configurações, e mudam sem deploy. Esta variável é só a rede de
# recurso para quando ainda não há nenhum modelo marcado como padrão.
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4.1-mini
OPENAI_TIMEOUT_SEGUNDOS=90
